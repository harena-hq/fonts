#!/usr/bin/env bash
# The layer that survives `git add -f` (AGENTS.md). Added, copied, modified and
# renamed paths are checked; a deletion is never refused.
staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')
if printf '%s\n' "$staged" | grep -qE '(^|/)\.private/'; then
  echo "refusing: staged path under .private/ (private context)" >&2
  exit 1
fi
# Font binaries are fetched or built, never committed. This is also the layer
# that keeps a Segoe file out of history (ui/AGENTS.md: measured, never copied).
if printf '%s\n' "$staged" | grep -qiE '\.(ttf|otf|ttc|otc|woff2?|eot)$'; then
  echo "refusing: staged font binary" >&2
  printf '%s\n' "$staged" | grep -iE '\.(ttf|otf|ttc|otc|woff2?|eot)$' >&2
  exit 1
fi
