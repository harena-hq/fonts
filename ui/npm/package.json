{
  "name": "@harena-hq/ui-font",
  "version": "0.9.0",
  "description": "Harena UI, a UI typeface with Segoe UI Variable's and Segoe Fluent Icons' geometry: a layout sized under Segoe comes out the same size.",
  "license": "OFL-1.1 AND MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harena-hq/fonts.git",
    "directory": "ui/npm"
  },
  "homepage": "https://github.com/harena-hq/fonts/tree/main/ui#readme",
  "bugs": {
    "url": "https://github.com/harena-hq/fonts/issues"
  },
  "harena": {
    "fontVersions": {
      "Harena UI": "0.3.0",
      "Harena UI J": "0.8.0",
      "Harena UI Icons": "0.5.2"
    }
  },
  "keywords": [
    "font",
    "ui",
    "segoe",
    "winui",
    "fluent",
    "icons",
    "hangul",
    "japanese",
    "cjk",
    "woff2"
  ],
  "style": "./index.css",
  "exports": {
    ".": "./index.css",
    "./index.css": "./index.css",
    "./ui.css": "./ui.css",
    "./j.css": "./j.css",
    "./icons.css": "./icons.css",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "fonts/",
    "index.css",
    "ui.css",
    "j.css",
    "icons.css",
    "README.md",
    "CHANGELOG.md",
    "OFL.txt",
    "THIRD_PARTY_NOTICES.md",
    "licenses/"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
